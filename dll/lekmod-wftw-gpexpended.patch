diff -ru a/CvGameCoreDLL_Expansion2/CvPlayer.cpp b/CvGameCoreDLL_Expansion2/CvPlayer.cpp
--- a/CvGameCoreDLL_Expansion2/CvPlayer.cpp	2026-09-22 21:07:41.511753300 -0400
+++ b/CvGameCoreDLL_Expansion2/CvPlayer.cpp	2026-09-22 21:07:41.535789800 -0400
@@ -18027,7 +18027,7 @@
 
 //	--------------------------------------------------------------------------------
 /// Do effects when a GP is consumed
-void CvPlayer::DoGreatPersonExpended(UnitTypes eGreatPersonUnit)
+void CvPlayer::DoGreatPersonExpended(UnitTypes eGreatPersonUnit, CvUnit* pGreatPersonUnit)
 {
 	// Gold gained
 	int iExpendGold = GetGreatPersonExpendGold();
@@ -18206,6 +18206,27 @@
 		bool bResult;
 		LuaSupport::CallHook(pkScriptSystem, "GreatPersonExpended", args.get(), bResult);
 	}
+
+	// PMMM: Lekmod's GreatPersonExpended passes only (player, unitType), and its own civ scripts read it that
+	// way, so it cannot change. Wish for the World needs the unit that was expended (its promotions, name and
+	// home city decide the Magical Girl it becomes), so raise a second hook with the Community Patch's
+	// arguments: (player, unitID, unitType, x, y).
+	if (pGreatPersonUnit != NULL)
+	{
+		ICvEngineScriptSystem1* pkPMMMScriptSystem = gDLL->GetScriptSystem();
+		if (pkPMMMScriptSystem)
+		{
+			CvLuaArgsHandle args;
+			args->Push(GetID());
+			args->Push(pGreatPersonUnit->GetID());
+			args->Push(eGreatPersonUnit);
+			args->Push(pGreatPersonUnit->getX());
+			args->Push(pGreatPersonUnit->getY());
+
+			bool bPMMMResult;
+			LuaSupport::CallHook(pkPMMMScriptSystem, "PMMMGreatPersonExpended", args.get(), bPMMMResult);
+		}
+	}
 }
 
