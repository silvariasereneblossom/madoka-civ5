 /// Is this AI willing to work with ePlayer?
 bool CvDiplomacyAI::IsDoFAcceptable(PlayerTypes ePlayer)
 {
+	// PMMM Ai Yo: no Declarations of Friendship with (or for) a player whose trait forbids them
+	if (ePlayer >= 0 && ePlayer < MAX_MAJOR_CIVS && (GET_PLAYER(ePlayer).IsPMMMNoFriendship() || GET_PLAYER(GetPlayer()->GetID()).IsPMMMNoFriendship()))
+		return false;
+
 	// Can't declare friendship with a civ you're at war with
 	if(GET_TEAM(GetTeam()).isAtWar(GET_PLAYER(ePlayer).getTeam()) || GC.getGame().isOption(GAMEOPTION_ALWAYS_WAR))
 	{
@@ -19911,6 +19915,10 @@
 
 void CvDiplomacyAI::SetDoFAccepted(PlayerTypes ePlayer, bool bValue)
 {
+	// PMMM Ai Yo: the backstop for any path (deals, events, Lua) that would still make one
+	if (bValue && ePlayer >= 0 && ePlayer < MAX_MAJOR_CIVS && (GET_PLAYER(ePlayer).IsPMMMNoFriendship() || GET_PLAYER(GetPlayer()->GetID()).IsPMMMNoFriendship()))
+		return;
+
 	CvAssertMsg(ePlayer >= 0, "DIPLOMACY_AI: Invalid Player Index.  Please send Jon this with your last 5 autosaves and what changelist # you're playing.");
 	CvAssertMsg(ePlayer < MAX_MAJOR_CIVS, "DIPLOMACY_AI: Invalid Player Index.  Please send Jon this with your last 5 autosaves and what changelist # you're playing.");
 
