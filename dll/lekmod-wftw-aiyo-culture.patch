+/// Ai Yo: the happiness her policies and ideology tenets would grant
+int CvPlayer::GetPMMMPolicyHappiness() const
+{
+	int iHappiness = GetPlayerPolicies()->GetNumericModifier(POLICYMOD_EXTRA_HAPPINESS);
+	iHappiness += getNumCities() * GetPlayerPolicies()->GetNumericModifier(POLICYMOD_EXTRA_HAPPINESS_PER_CITY);
+	return max(iHappiness, 0);
+}
+
+/// Ai Yo: twice that happiness, as Culture per turn
+int CvPlayer::GetPMMMCultureFromPolicyHappinessTimes100() const
+{
+	if (!IsPMMMPolicyHappinessToCulture())
+		return 0;
+
+	return GetPMMMPolicyHappiness() * 2 * 100;
+}
+
+/// Ai Yo's Culture conversion flag, cached per leader and never serialized
+void CvPlayer::PMMMRefreshCultureTraitCache() const
+{
+	const int iLeader = (int)getLeaderType();
+	if (m_iPMMMCultureCacheLeader == iLeader)
+		return;
+
+	m_iPMMMCultureCacheLeader = iLeader;
+	m_bPMMMPolicyHappinessToCulture = false;
+	if (iLeader < 0 || !isMajorCiv())
+		return;
+
+	const CvLeaderHeadInfo& kLeader = getLeaderInfo();
+	for (int iI = 0; iI < GC.getNumTraitInfos(); iI++)
+	{
+		if (!kLeader.hasTrait(iI))
+			continue;
+		CvTraitEntry* pTrait = GC.getTraitInfo((TraitTypes)iI);
+		if (pTrait != NULL && pTrait->IsPMMMPolicyHappinessToCulture())
+			m_bPMMMPolicyHappinessToCulture = true;
+	}
+}
+
+bool CvPlayer::IsPMMMPolicyHappinessToCulture() const
+{
+	PMMMRefreshCultureTraitCache();
+	return m_bPMMMPolicyHappinessToCulture;
+}
